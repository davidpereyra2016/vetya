{
  "expo": {
    "name": "Zuvia",
    "slug": "vetya",
    "scheme": "vetya",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetya.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zuvia necesita acceso a tu ubicación para mostrarte veterinarios cercanos disponibles para emergencias."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 16,
      "package": "com.vetya.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      [
        "expo-maps",
        {
          "mode": "universal"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 288
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "cb540aaf-1e99-4772-8d7c-457df269ad59"
      }
    },
    "owner": "davidpereyra"
  }
}
