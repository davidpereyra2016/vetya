<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorias de Consejos - Vetya Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Nunito', Arial, sans-serif; background-color: #f8f9fc; }
    .sidebar { min-height: 100vh; }
    .card { border: 0; box-shadow: 0 0.15rem 1.75rem rgba(58,59,69,.12); }
    .color-dot { display: inline-block; width: 18px; height: 18px; border-radius: 50%; vertical-align: middle; border: 1px solid #ddd; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <% const activeMenu = 'consejos-salud'; %>
      <%- include('../partials/sidebar') %>
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2"><i class="fas fa-tags me-2 text-primary"></i>Categorias</h1>
          <a href="/admin/consejos-salud" class="btn btn-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
        </div>
        <% if (mensaje) { %><div class="alert alert-success"><%= mensaje %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="row">
          <div class="col-lg-4 mb-4">
            <div class="card">
              <div class="card-body">
                <h5 class="fw-bold mb-3">Nueva categoria</h5>
                <form method="POST" action="/admin/consejos-salud/categorias">
                  <div class="mb-3"><label class="form-label">Nombre *</label><input class="form-control" name="nombre" required></div>
                  <div class="mb-3"><label class="form-label">Descripcion</label><textarea class="form-control" name="descripcion" rows="2"></textarea></div>
                  <div class="mb-3"><label class="form-label">Color</label><input class="form-control form-control-color" name="color" type="color" value="#1E88E5"></div>
                  <div class="mb-3"><label class="form-label">Icono Ionicons</label><input class="form-control" name="icono" value="medical"></div>
                  <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="activo" id="activoNueva" checked><label class="form-check-label" for="activoNueva">Activa</label></div>
                  <button class="btn btn-primary w-100" type="submit"><i class="fas fa-plus me-2"></i>Crear</button>
                </form>
              </div>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="card">
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead><tr><th>Categoria</th><th>Uso</th><th>Estado</th><th>Editar</th><th>Eliminar</th></tr></thead>
                    <tbody>
                      <% categorias.forEach((cat) => { const uso = usosPorSlug[cat.slug] || 0; %>
                        <tr>
                          <td>
                            <span class="color-dot me-2" style="background:<%= cat.color %>"></span>
                            <strong><%= cat.nombre %></strong><br>
                            <small class="text-muted"><%= cat.descripcion || cat.slug %></small>
                          </td>
                          <td><span class="badge bg-light text-dark"><%= uso %> consejos</span></td>
                          <td><span class="badge <%= cat.activo ? 'bg-success' : 'bg-secondary' %>"><%= cat.activo ? 'Activa' : 'Inactiva' %></span></td>
                          <td>
                            <form method="POST" action="/admin/consejos-salud/categorias/<%= cat._id %>/editar" class="row g-2">
                              <div class="col-md-4"><input class="form-control form-control-sm" name="nombre" value="<%= cat.nombre %>" required></div>
                              <div class="col-md-3"><input class="form-control form-control-sm" name="icono" value="<%= cat.icono %>"></div>
                              <div class="col-md-2"><input class="form-control form-control-color form-control-sm" name="color" type="color" value="<%= cat.color || '#1E88E5' %>"></div>
                              <div class="col-md-2 form-check pt-1"><input class="form-check-input" type="checkbox" name="activo" <%= cat.activo ? 'checked' : '' %>></div>
                              <input type="hidden" name="descripcion" value="<%= cat.descripcion || '' %>">
                              <div class="col-md-1"><button class="btn btn-sm btn-outline-primary" type="submit"><i class="fas fa-save"></i></button></div>
                            </form>
                          </td>
                          <td>
                            <form method="POST" action="/admin/consejos-salud/categorias/<%= cat._id %>/eliminar" onsubmit="return confirm('Eliminar categoria?')">
                              <button class="btn btn-sm btn-outline-danger" type="submit" <%= uso > 0 ? 'disabled title="Categoria en uso"' : '' %>><i class="fas fa-trash"></i></button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
