<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= consejo ? 'Editar' : 'Nuevo' %> Consejo - Vetya Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Nunito', Arial, sans-serif; background-color: #f8f9fc; }
    .sidebar { min-height: 100vh; }
    .card { border: 0; box-shadow: 0 0.15rem 1.75rem rgba(58,59,69,.12); }
    .section-title { font-size: .8rem; text-transform: uppercase; color: #4e73df; font-weight: 800; border-bottom: 1px solid #e3e6f0; padding-bottom: .5rem; margin-bottom: 1rem; }
    .preview-img { width: 160px; height: 110px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd; }
    .markdown-help code { color: #4e73df; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <% const activeMenu = 'consejos-salud'; %>
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2"><i class="fas fa-notes-medical me-2 text-primary"></i><%= consejo ? 'Editar Consejo' : 'Nuevo Consejo' %></h1>
          <a href="/admin/consejos-salud" class="btn btn-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
        </div>

        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

        <form method="POST" action="<%= consejo ? '/admin/consejos-salud/' + consejo._id + '/editar' : '/admin/consejos-salud/nuevo' %>" enctype="multipart/form-data">
          <div class="row">
            <div class="col-lg-8 mb-4">
              <div class="card">
                <div class="card-body">
                  <div class="section-title"><i class="fas fa-file-alt me-2"></i>Contenido</div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Titulo *</label>
                    <input type="text" name="titulo" class="form-control" maxlength="160" required value="<%= consejo ? consejo.titulo : '' %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Resumen *</label>
                    <textarea name="resumen" rows="3" maxlength="360" class="form-control" required><%= consejo ? consejo.resumen : '' %></textarea>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Contenido Markdown *</label>
                    <textarea name="contenido" id="contenidoMarkdown" rows="14" class="form-control" required><%= consejo ? consejo.contenido : '' %></textarea>
                    <div class="form-text markdown-help">
                      Formato: <code>## Subtitulo</code>, <code>**negrita**</code>, <code>- lista</code>, <code>[texto](https://url.com)</code>
                    </div>
                  </div>
                  <div class="card bg-light">
                    <div class="card-body">
                      <div class="fw-bold mb-2">Vista previa rapida</div>
                      <div id="markdownPreview" class="small text-muted"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-4 mb-4">
              <div class="card mb-4">
                <div class="card-body">
                  <div class="section-title"><i class="fas fa-sliders-h me-2"></i>Publicacion</div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Imagen principal <%= consejo ? '' : '*' %></label>
                    <input type="file" name="imagen" accept="image/*" class="form-control" <%= consejo ? '' : 'required' %>>
                    <% if (consejo && consejo.imagen) { %>
                      <img src="<%= consejo.imagen %>" class="preview-img mt-2" alt="imagen actual">
                    <% } %>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Categoria *</label>
                    <select name="categoriaId" class="form-select">
                      <option value="">Seleccionar categoria</option>
                      <% categorias.forEach((cat) => { %>
                        <option value="<%= cat._id %>" <%= consejo && (String(consejo.categoriaRef) === String(cat._id) || consejo.categoriaSlug === cat.slug || consejo.categoria === cat.nombre) ? 'selected' : '' %>><%= cat.nombre %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">O crear categoria nueva</label>
                    <input type="text" name="nuevaCategoria" class="form-control" placeholder="Ej: Dermatologia">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Tipos de mascota</label>
                    <% const tipos = consejo && consejo.paraTipos ? consejo.paraTipos : ['Todos']; %>
                    <select name="paraTipos" class="form-select" multiple size="6">
                      <% ['Todos','Perro','Gato','Ave','Reptil','Roedor','Pez','Conejo'].forEach((tipo) => { %>
                        <option value="<%= tipo %>" <%= tipos.includes(tipo) ? 'selected' : '' %>><%= tipo %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="row">
                    <div class="col-6 mb-3">
                      <label class="form-label">Lectura</label>
                      <input type="number" min="1" max="60" name="tiempoLectura" class="form-control" value="<%= consejo ? consejo.tiempoLectura || 5 : 5 %>">
                    </div>
                    <div class="col-6 mb-3">
                      <label class="form-label">Fecha</label>
                      <input type="date" name="fechaPublicacion" class="form-control" value="<%= consejo && consejo.fechaPublicacion ? new Date(consejo.fechaPublicacion).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
                    </div>
                  </div>
                  <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="activo" id="activo" <%= !consejo || consejo.activo ? 'checked' : '' %>>
                    <label class="form-check-label" for="activo">Publicado</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="destacado" id="destacado" <%= consejo && consejo.destacado ? 'checked' : '' %>>
                    <label class="form-check-label" for="destacado">Destacado</label>
                  </div>
                </div>
              </div>

              <div class="card">
                <div class="card-body">
                  <div class="section-title"><i class="fas fa-user-md me-2"></i>Autor y fuente</div>
                  <div class="mb-3">
                    <label class="form-label">Autor visible</label>
                    <input type="text" name="autor" class="form-control" value="<%= consejo ? consejo.autor || '' : 'Equipo Vetya' %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Medico veterinario citado</label>
                    <input type="text" name="medicoCitado" class="form-control" value="<%= consejo ? consejo.medicoCitado || '' : '' %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Fuente / enlace</label>
                    <input type="url" name="fuente" class="form-control" value="<%= consejo ? consejo.fuente || '' : '' %>">
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Etiquetas separadas por coma</label>
                    <input type="text" name="etiquetas" class="form-control" value="<%= consejo && consejo.etiquetas ? consejo.etiquetas.join(', ') : '' %>">
                  </div>
                  <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save me-2"></i>Guardar consejo</button>
                </div>
              </div>
            </div>
          </div>
        </form>
      </main>
    </div>
  </div>
  <script>
    const textarea = document.getElementById('contenidoMarkdown');
    const preview = document.getElementById('markdownPreview');
    const renderPreview = () => {
      const text = textarea.value || '';
      preview.innerHTML = text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/^### (.*)$/gm, '<h6>$1</h6>')
        .replace(/^## (.*)$/gm, '<h5>$1</h5>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>')
        .replace(/\n/g, '<br>');
    };
    textarea.addEventListener('input', renderPreview);
    renderPreview();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
