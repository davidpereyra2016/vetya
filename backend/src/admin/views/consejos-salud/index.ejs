<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consejos de Salud - Vetya Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Nunito', Arial, sans-serif; background-color: #f8f9fc; }
    .sidebar { min-height: 100vh; box-shadow: 0 0.15rem 1.75rem rgba(58,59,69,.15); }
    .card { border: 0; box-shadow: 0 0.15rem 1.75rem rgba(58,59,69,.12); }
    .border-left-primary { border-left: .25rem solid #4e73df !important; }
    .border-left-success { border-left: .25rem solid #1cc88a !important; }
    .border-left-warning { border-left: .25rem solid #f6c23e !important; }
    .border-left-info { border-left: .25rem solid #36b9cc !important; }
    .thumb { width: 72px; height: 52px; object-fit: cover; border-radius: 6px; border: 1px solid #e3e6f0; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <% const activeMenu = 'consejos-salud'; %>
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2"><i class="fas fa-notes-medical me-2 text-primary"></i>Consejos de Salud</h1>
          <div class="d-flex gap-2">
            <a href="/admin/consejos-salud/categorias" class="btn btn-outline-primary"><i class="fas fa-tags me-2"></i>Categorias</a>
            <a href="/admin/consejos-salud/nuevo" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Nuevo consejo</a>
          </div>
        </div>

        <% if (mensaje) { %><div class="alert alert-success alert-dismissible fade show"><%= mensaje %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
        <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

        <div class="row mb-4">
          <div class="col-xl-3 col-md-6 mb-3"><div class="card border-left-primary py-2"><div class="card-body"><div class="text-xs fw-bold text-primary text-uppercase mb-1">Total</div><div class="h5 fw-bold"><%= estadisticas.total %></div></div></div></div>
          <div class="col-xl-3 col-md-6 mb-3"><div class="card border-left-success py-2"><div class="card-body"><div class="text-xs fw-bold text-success text-uppercase mb-1">Publicados</div><div class="h5 fw-bold"><%= estadisticas.publicados %></div></div></div></div>
          <div class="col-xl-3 col-md-6 mb-3"><div class="card border-left-warning py-2"><div class="card-body"><div class="text-xs fw-bold text-warning text-uppercase mb-1">Destacados</div><div class="h5 fw-bold"><%= estadisticas.destacados %></div></div></div></div>
          <div class="col-xl-3 col-md-6 mb-3"><div class="card border-left-info py-2"><div class="card-body"><div class="text-xs fw-bold text-info text-uppercase mb-1">Categorias</div><div class="h5 fw-bold"><%= estadisticas.categorias %></div></div></div></div>
        </div>

        <div class="card">
          <div class="card-header py-3"><h6 class="m-0 fw-bold text-primary">Listado de consejos</h6></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Imagen</th>
                    <th>Consejo</th>
                    <th>Categoria</th>
                    <th>Estado</th>
                    <th>Metricas</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (consejos.length === 0) { %>
                    <tr><td colspan="6" class="text-center text-muted py-4">Todavia no hay consejos cargados.</td></tr>
                  <% } %>
                  <% consejos.forEach((consejo) => { %>
                    <tr>
                      <td><img src="<%= consejo.imagen %>" class="thumb" alt="consejo"></td>
                      <td>
                        <div class="fw-bold"><%= consejo.titulo %></div>
                        <small class="text-muted"><%= consejo.resumen %></small>
                      </td>
                      <td><span class="badge bg-light text-dark"><%= consejo.categoria %></span></td>
                      <td>
                        <span class="badge <%= consejo.activo ? 'bg-success' : 'bg-secondary' %>"><%= consejo.activo ? 'Publicado' : 'Oculto' %></span>
                        <% if (consejo.destacado) { %><span class="badge bg-warning text-dark">Destacado</span><% } %>
                      </td>
                      <td>
                        <small><i class="fas fa-eye me-1"></i><%= consejo.visualizaciones || 0 %></small><br>
                        <small><i class="fas fa-heart me-1"></i><%= consejo.likes || 0 %></small>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <a class="btn btn-outline-primary" href="/admin/consejos-salud/<%= consejo._id %>"><i class="fas fa-eye"></i></a>
                          <a class="btn btn-outline-secondary" href="/admin/consejos-salud/<%= consejo._id %>/editar"><i class="fas fa-edit"></i></a>
                        </div>
                        <div class="btn-group btn-group-sm mt-1">
                          <form method="POST" action="/admin/consejos-salud/<%= consejo._id %>/toggle-activo"><button class="btn btn-outline-success" type="submit"><i class="fas fa-power-off"></i></button></form>
                          <form method="POST" action="/admin/consejos-salud/<%= consejo._id %>/toggle-destacado"><button class="btn btn-outline-warning" type="submit"><i class="fas fa-star"></i></button></form>
                          <form method="POST" action="/admin/consejos-salud/<%= consejo._id %>/eliminar" onsubmit="return confirm('Eliminar este consejo?')"><button class="btn btn-outline-danger" type="submit"><i class="fas fa-trash"></i></button></form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
