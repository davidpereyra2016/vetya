<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= consejo.titulo %> - Vetya Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Nunito', Arial, sans-serif; background-color: #f8f9fc; }
    .sidebar { min-height: 100vh; }
    .card { border: 0; box-shadow: 0 0.15rem 1.75rem rgba(58,59,69,.12); }
    .hero-img { width: 100%; max-height: 320px; object-fit: cover; border-radius: 12px; }
    .content-preview { white-space: pre-wrap; line-height: 1.7; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <% const activeMenu = 'consejos-salud'; %>
      <%- include('../partials/sidebar') %>
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2"><i class="fas fa-notes-medical me-2 text-primary"></i>Detalle</h1>
          <div class="d-flex gap-2">
            <a href="/admin/consejos-salud/<%= consejo._id %>/editar" class="btn btn-primary"><i class="fas fa-edit me-2"></i>Editar</a>
            <a href="/admin/consejos-salud" class="btn btn-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
          </div>
        </div>
        <% if (mensaje) { %><div class="alert alert-success"><%= mensaje %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="row">
          <div class="col-lg-8 mb-4">
            <div class="card">
              <div class="card-body">
                <img src="<%= consejo.imagen %>" class="hero-img mb-4" alt="consejo">
                <div class="mb-2">
                  <span class="badge bg-primary"><%= consejo.categoria %></span>
                  <% if (consejo.destacado) { %><span class="badge bg-warning text-dark">Destacado</span><% } %>
                  <span class="badge <%= consejo.activo ? 'bg-success' : 'bg-secondary' %>"><%= consejo.activo ? 'Publicado' : 'Oculto' %></span>
                </div>
                <h2><%= consejo.titulo %></h2>
                <p class="lead"><%= consejo.resumen %></p>
                <hr>
                <div class="content-preview"><%= consejo.contenido %></div>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="card">
              <div class="card-body">
                <h5 class="fw-bold mb-3">Metadatos</h5>
                <p><strong>Autor:</strong><br><%= consejo.autor || 'Equipo Vetya' %></p>
                <p><strong>Medico citado:</strong><br><%= consejo.medicoCitado || '-' %></p>
                <p><strong>Fuente:</strong><br><% if (consejo.fuente) { %><a href="<%= consejo.fuente %>" target="_blank"><%= consejo.fuente %></a><% } else { %>-<% } %></p>
                <p><strong>Tipos:</strong><br><%= (consejo.paraTipos || []).join(', ') %></p>
                <p><strong>Etiquetas:</strong><br><%= (consejo.etiquetas || []).join(', ') || '-' %></p>
                <p><strong>Lectura:</strong> <%= consejo.tiempoLectura || 5 %> min</p>
                <p><strong>Visualizaciones:</strong> <%= consejo.visualizaciones || 0 %></p>
                <p><strong>Likes:</strong> <%= consejo.likes || 0 %></p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
